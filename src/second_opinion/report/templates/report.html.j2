</div>
<div id="tip" role="tooltip" hidden><strong id="tip-v"></strong><span id="tip-l"></span></div>
<script>
(() => {
  const tip = document.getElementById("tip"), tv = document.getElementById("tip-v"), tl = document.getElementById("tip-l");
  const show = (el) => {
    tv.textContent = el.dataset.tipValue || "";
    tl.textContent = el.dataset.tipLabel || "";
    tip.hidden = false;
    const r = el.getBoundingClientRect(), t = tip.getBoundingClientRect();
    const x = Math.max(8, Math.min(r.left + r.width / 2 - t.width / 2, innerWidth - t.width - 8));
    let y = r.top - t.height - 10;
    if (y < 8) y = r.bottom + 10;
    tip.style.left = x + "px";
    tip.style.top = y + "px";
  };
  const hide = () => { tip.hidden = true; };
  document.querySelectorAll("[data-tip-value]").forEach((el) => {
    el.addEventListener("pointerenter", () => show(el));
    el.addEventListener("pointerleave", hide);
    el.addEventListener("focus", () => show(el));
    el.addEventListener("blur", hide);
  });
  document.addEventListener("keydown", (e) => { if (e.key === "Escape") hide(); });
  const btn = document.getElementById("theme"), root = document.documentElement, modes = ["auto", "light", "dark"];
  const apply = (m) => {
    if (m === "auto") root.removeAttribute("data-theme"); else root.setAttribute("data-theme", m);
    btn.textContent = "Theme: " + m;
  };
  let mode = "auto";
  try { mode = localStorage.getItem("so-theme") || "auto"; } catch (e) {}
  const fromUrl = new URLSearchParams(location.search).get("theme");
  if (modes.includes(fromUrl)) mode = fromUrl;
  apply(modes.includes(mode) ? mode : "auto");
  btn.addEventListener("click", () => {
    mode = modes[(modes.indexOf(mode) + 1) % modes.length];
    apply(mode);
    try { localStorage.setItem("so-theme", mode); } catch (e) {}
  });
})();
</script>
</body>
</html>
